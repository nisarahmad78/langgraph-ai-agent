# Copy this file to .env and fill in your values.

# Required: API key for your LLM provider (any OpenAI-compatible API works).
OPENAI_API_KEY=sk-your-api-key-here

# Optional: custom endpoint, e.g. a local server or another provider.
# Leave empty to use the default OpenAI endpoint.
OPENAI_BASE_URL=

# Optional: model name. Defaults to gpt-4o-mini.
LLM_MODEL=gpt-4o-mini
